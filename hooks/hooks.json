{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}\"/hooks/session_start.py || python \"${CLAUDE_PLUGIN_ROOT}\"/hooks/session_start.py || exit 0",
            "timeout": 20,
            "statusMessage": "Loading PMM OS"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}\"/hooks/user_prompt_submit.py || python \"${CLAUDE_PLUGIN_ROOT}\"/hooks/user_prompt_submit.py || exit 0",
            "timeout": 20,
            "statusMessage": "Routing marketing workflow"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}\"/hooks/subagent_start.py || python \"${CLAUDE_PLUGIN_ROOT}\"/hooks/subagent_start.py || exit 0",
            "timeout": 20,
            "statusMessage": "Sharing PMM OS context with subagent"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}\"/hooks/pre_tool_use_policy.py || python \"${CLAUDE_PLUGIN_ROOT}\"/hooks/pre_tool_use_policy.py || exit 0",
            "timeout": 20,
            "statusMessage": "Checking marketing tool policy"
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}\"/hooks/research_guard.py || python \"${CLAUDE_PLUGIN_ROOT}\"/hooks/research_guard.py || exit 0",
            "timeout": 20,
            "statusMessage": "Checking research invocation"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}\"/hooks/post_tool_use_review.py || python \"${CLAUDE_PLUGIN_ROOT}\"/hooks/post_tool_use_review.py || exit 0",
            "timeout": 20,
            "statusMessage": "Reviewing marketing tool result"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}\"/hooks/stop_quality_gate.py || python \"${CLAUDE_PLUGIN_ROOT}\"/hooks/stop_quality_gate.py || exit 0",
            "timeout": 20,
            "statusMessage": "Checking marketing deliverable quality"
          }
        ]
      }
    ]
  }
}
