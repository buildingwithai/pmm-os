.DS_Store

# The marketing site + PMM OS Cloud live in buildingwithai/pmm-os-web.
# Guard against a stray working copy being re-added here.
website/

# Never track local env files anywhere in this tree.
.env
.env.*
!.env.example
node_modules/
*.bak
*.log
# generated launch-kit instances (the generator/templates are tracked; built outputs aren't)
**/*-launch-kit.html
**/generated-docs/
**/deck.md

**/node_modules/
**/.next/
**/.turbo/
.next/
tsconfig.tsbuildinfo
.vercel
__pycache__/
*.pyc
*.pyo
config/mcporter.json

# demo working copies (generated: editor scripts copied in + built kit output)

# session handoff notes (never commit — may reference private strategy)
# Session handoffs — real traction numbers, business decisions, owner-only state.
# The repo is public; these never ship. Glob, not a literal, so dated ones are covered.
HANDOFF*.md
