#!/usr/bin/env node
/**
 * pmm-research — the only sanctioned way to invoke PMM OS's research engines.
 *
 * hooks/research_guard.py denies every other spelling and points here. This exists
 * because two silent failures were possible by hand and neither was catchable:
 *
 *   1. Invented flags. argparse printed usage, exit 2, the run continued.
 *   2. `--quick` returned 5 items from 2 sources and looked like a normal run.
 *      `--deep` with a plan returned 129 items from 6 sources on the same topic.
 *
 * What this adds that a hand-written command cannot:
 *   - resolves a Python the engine can run on (needs 3.12+, stock macOS ships 3.9)
 *   - validates the plan BEFORE launch (planner._sanitize_plan silently drops
 *     subqueries missing search_query/ranking_query and falls back to a
 *     deterministic plan with no message anyone would notice)
 *   - prints a RUN RECEIPT from the engine's own last-run.json, because a degraded
 *     run exits 0 and can print "Research quality: 5/5 core sources" while four
 *     sources returned nothing
 *
 * Node ESM to match bin/cli.mjs, so Windows works without bash.
 */
import { existsSync, readFileSync } from 'node:fs';
import { spawnSync } from 'node:child_process';
import { homedir } from 'node:os';
import { dirname, join, resolve } from 'node:path';
import { fileURLToPath } from 'node:url';

const ROOT = join(dirname(fileURLToPath(import.meta.url)), '..');
const HOME = homedir();
const CONTRACT = JSON.parse(readFileSync(join(ROOT, 'config', 'engine-contract.json'), 'utf8'));

const log = (s) => console.log(s);
const err = (s) => console.error(s);

// Canonical engine source names. `--search` rejects anything else outright
// (last30days.py:82-95 SystemExits), and it is ALSO the only way to reach
// threads/pinterest/linkedin/jobs/trustpilot/xiaohongshu/perplexity at all.
const CANONICAL = new Set([
  'reddit', 'hackernews', 'polymarket', 'github', 'x', 'youtube', 'tiktok',
  'instagram', 'threads', 'pinterest', 'grounding', 'jobs', 'bluesky',
  'truthsocial', 'digg', 'arxiv', 'techmeme', 'trustpilot', 'xiaohongshu',
  'linkedin', 'perplexity', 'stocktwits',
]);
const ALIAS = { hn: 'hackernews', web: 'grounding', twitter: 'x', bsky: 'bluesky', xhs: 'xiaohongshu' };

function usage(code = 2) {
  log(`pmm-research — sanctioned entry point for PMM OS research

  pmm-research last30days <TOPIC> --depth deep --plan-file <path> [options]
  pmm-research reach <verb> [args...]
  pmm-research health [--json]

Options for last30days:
  --depth deep|default     required. 'quick' is rejected — it truncates your plan
                           to ONE subquery and caps to 2 sources.
  --plan-file <path>       required for named-entity topics (LAW 7). JSON query plan.
  --days <1-365>           default 30. The engine itself has NO range validation.
  --exclude <a,b>          drop live sources, each needs a reason via --why
  --why <text>             justification recorded in the receipt
  --emit compact|json|brief
  --no-plan --reason <t>   explicit, recorded opt-out for generic-concept topics`);
  process.exit(code);
}

function resolvePython() {
  const want = (p) => {
    const r = spawnSync(p, ['-c', 'import sys;sys.exit(0 if sys.version_info>=(3,12) else 1)'],
      { stdio: 'ignore' });
    return r.status === 0;
  };
  if (process.env.L30D_PYTHON) {
    if (!want(process.env.L30D_PYTHON)) {
      err(`✗ L30D_PYTHON=${process.env.L30D_PYTHON} is not Python 3.12+`);
      process.exit(2);
    }
    return process.env.L30D_PYTHON;
  }
  // 3.13/3.12 first: the engine sets a floor of 3.12 and no ceiling, and nothing
  // above 3.13 has been tested.
  for (const c of ['python3.13', 'python3.12', 'python3.14', 'python3', 'python']) {
    if (want(c)) return c;
  }
  const uv = spawnSync('uv', ['python', 'find', '>=3.12'], { encoding: 'utf8' });
  if (uv.status === 0 && uv.stdout.trim() && want(uv.stdout.trim())) return uv.stdout.trim();
  err(`✗ No Python 3.12+ found. Install one:
    brew install python@3.13          (macOS)
    uv python install 3.13            (any platform)
    winget install Python.Python.3.13 (Windows)
  Or point at an existing one: L30D_PYTHON=/path/to/python3.13`);
  process.exit(2);
}

/** planner._sanitize_plan drops malformed subqueries in silence. Catch it here. */
function validatePlan(path) {
  if (!existsSync(path)) return [`plan file not found: ${path}`];
  let plan;
  try { plan = JSON.parse(readFileSync(path, 'utf8')); }
  catch (e) { return [`plan is not valid JSON: ${e.message}`]; }
  const problems = [];
  if (!plan.intent) problems.push('plan has no "intent"');
  const subs = plan.subqueries;
  if (!Array.isArray(subs) || subs.length === 0) {
    problems.push('plan has no "subqueries" array');
  } else {
    subs.forEach((s, i) => {
      if (!s || typeof s !== 'object') { problems.push(`subquery[${i}] is not an object`); return; }
      if (!s.search_query) problems.push(`subquery[${i}] has no "search_query" — the engine drops it silently`);
      if (!s.ranking_query) problems.push(`subquery[${i}] has no "ranking_query" — the engine drops it silently`);
    });
  }
  return problems;
}

function parseArgs(argv) {
  const o = { topic: [], emit: 'compact', days: 30, exclude: [] };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    const next = () => argv[++i];
    if (a === '--depth') o.depth = next();
    else if (a === '--plan-file') o.planFile = next();
    else if (a === '--days') o.days = Number(next());
    else if (a === '--exclude') o.exclude = next().split(',').map((s) => s.trim()).filter(Boolean);
    else if (a === '--why') o.why = next();
    else if (a === '--emit') o.emit = next();
    else if (a === '--no-plan') o.noPlan = true;
    else if (a === '--reason') o.reason = next();
    else if (a === '--json-receipt') o.receiptPath = next();
    // Accept the wrong spellings explicitly so validateArgs can explain them,
    // rather than dumping them into a generic "unknown flag" list. These are the
    // exact flags that were typed by hand and failed silently.
    else if (a === '--quick') o.depth = 'quick';
    else if (a === '--deep') o.depth = 'deep';
    else if (a === '--sources' || a === '--search') { o.badSearch = next(); }
    else if (a === '--limit') { o.badLimit = next(); }
    else if (a.startsWith('--')) o.unknown = (o.unknown || []).concat(a);
    else o.topic.push(a);
  }
  o.topic = o.topic.join(' ');
  return o;
}

function validateArgs(o) {
  const p = [];
  if (o.unknown?.length) {
    p.push(`unknown flag(s): ${o.unknown.join(', ')}. Source selection is --search-free here — `
      + `the wrapper synthesizes it. Depth is --depth deep.`);
  }
  if (o.badSearch !== undefined) {
    p.push(`--sources / --search are not yours to set. The wrapper synthesizes --search from a `
      + `live health check, because it is a HARD FILTER: an omitted source is a dropped source, `
      + `and threads/pinterest/linkedin/jobs/trustpilot are unreachable unless named there. `
      + `To drop one deliberately: --exclude ${o.badSearch} --why "<reason>"`);
  }
  if (o.badLimit !== undefined) {
    p.push('--limit is not a flag on this engine. Result volume comes from --depth deep; '
      + 'the time window is --days.');
  }
  if (!o.topic) p.push('no topic given');
  if (!o.depth) p.push('--depth is required (deep or default)');
  else if (o.depth === 'quick') {
    p.push('--depth quick is rejected: it truncates your plan to ONE subquery (planner.py:273) '
      + 'and caps to 2 sources. Measured: quick = 5 items / 2 sources; deep + plan = 129 / 6.');
  } else if (!['deep', 'default'].includes(o.depth)) p.push(`--depth ${o.depth} is not valid`);
  if (!Number.isInteger(o.days) || o.days < 1 || o.days > 365) {
    p.push(`--days ${o.days} out of range 1-365 (the engine does NOT validate this)`);
  }
  if (!o.planFile && !o.noPlan) {
    p.push('--plan-file is required (LAW 7). For a generic-concept topic, pass '
      + '--no-plan --reason "<why>" and it will be recorded in the receipt.');
  }
  if (o.noPlan && !o.reason) p.push('--no-plan requires --reason');
  if (o.exclude.length && !o.why) p.push('--exclude requires --why (recorded in the receipt)');
  for (const s of o.exclude) {
    const c = ALIAS[s] || s;
    if (!CANONICAL.has(c)) p.push(`--exclude ${s}: not a source name`);
  }
  if (o.planFile) p.push(...validatePlan(resolve(o.planFile)));
  return p;
}

/** Read the engine's own last-run.json rather than grepping stderr (errors go to stdout). */
function buildReceipt(o, requested) {
  const lastRun = join(HOME, '.config', 'last30days', 'last-run.json');
  let run = null;
  try { run = JSON.parse(readFileSync(lastRun, 'utf8')); } catch { /* engine may not have written one */ }
  if (!run) return { verdict: 'UNKNOWN', note: 'engine wrote no last-run.json' };

  const sources = run.sources || {};
  const total = Object.values(sources).reduce((a, b) => a + (Number(b) || 0), 0);
  const zero = Object.entries(sources).filter(([, n]) => !n).map(([s]) => s);
  const silent = requested.length
    ? requested.filter((s) => !(sources[s] > 0))
    : zero;

  let verdict = 'CLEAN';
  if (!o.planFile && !o.noPlan) verdict = 'NO-PLAN';
  else if (o.depth !== 'deep') verdict = 'WRONG-DEPTH';
  else if (silent.length) verdict = 'DEGRADED';
  else if (total < 25) verdict = 'THIN';

  return { verdict, topic: run.topic || o.topic, depth: o.depth, days: o.days,
           plan: o.planFile ? 'yes' : `no (${o.reason || 'unstated'})`,
           sources, total, silentZero: silent, excluded: o.exclude, why: o.why };
}

function renderReceipt(r) {
  const lines = ['', '=== PMM OS RUN RECEIPT ===', `verdict:   ${r.verdict}`];
  if (r.note) lines.push(`note:      ${r.note}`);
  if (r.topic) lines.push(`topic:     ${r.topic}`);
  lines.push(`depth:     ${r.depth}        plan: ${r.plan}        days: ${r.days}`);
  if (r.sources) {
    lines.push('returned:  ' + Object.entries(r.sources).map(([s, n]) => `${s}=${n}`).join(' '));
    lines.push(`total:     ${r.total} items`);
  }
  if (r.silentZero?.length) {
    lines.push(`silent-zero: ${r.silentZero.join(', ')}   (requested, returned nothing)`);
    lines.push('');
    lines.push('The engine\'s "Research quality: N/5 core sources" line does NOT cover these —');
    lines.push('they are scored as bonus, so an unpaid API key reads as a thin topic.');
  }
  if (r.excluded?.length) lines.push(`excluded:  ${r.excluded.join(', ')} — ${r.why}`);
  if (r.verdict !== 'CLEAN') {
    lines.push('');
    lines.push('REQUIRED: do not describe this run as complete. State the gap and its cause,');
    lines.push('then either run `npx pmm-os connect` or record it in the ledger\'s Gaps block.');
  }
  lines.push('=== END RECEIPT ===');
  return lines.join('\n');
}

// ---------------------------------------------------------------- main

const [, , cmd, ...rest] = process.argv;

if (!cmd || ['-h', '--help', 'help'].includes(cmd)) usage(0);

if (cmd === 'health') {
  const r = spawnSync('bash', [join(ROOT, 'skills', 'agent-reach', 'scripts', 'reach.sh'), 'doctor'],
    { stdio: 'inherit' });
  process.exit(r.status ?? 1);
}

if (cmd === 'reach') {
  const r = spawnSync('bash', [join(ROOT, 'skills', 'agent-reach', 'scripts', 'reach.sh'), ...rest],
    { stdio: 'inherit', env: { ...process.env, PMM_OS_LAUNCH: '1' } });
  process.exit(r.status ?? 1);
}

if (cmd !== 'last30days') usage(2);

const opts = parseArgs(rest);
const problems = validateArgs(opts);
if (problems.length) {
  err('✗ pmm-research: refusing to run\n');
  for (const p of problems) err(`  • ${p}`);
  err('\n' + CONTRACT.sanctioned.usage);
  process.exit(2);
}

const PY = resolvePython();
const ENGINE = join(ROOT, 'skills', 'last30days', 'scripts', 'last30days.py');
const args = [ENGINE, opts.topic, `--emit=${opts.emit}`, '--days', String(opts.days)];
if (opts.depth === 'deep') args.push('--deep');
if (opts.planFile) args.push('--plan', resolve(opts.planFile));

// Phase 2 replaces this with a live-health-derived --search. Until then we omit it
// (the engine then uses everything credentials allow) and say so in the receipt.
log(`→ ${PY} last30days.py "${opts.topic}" --depth ${opts.depth}`
  + (opts.planFile ? ' --plan ✓' : ' (no plan)'));

const run = spawnSync(PY, args, {
  stdio: 'inherit',
  env: { ...process.env, PMM_OS_LAUNCH: '1',
         LAST30DAYS_TRANSCRIPT_LIMIT: process.env.LAST30DAYS_TRANSCRIPT_LIMIT || '1000',
         LAST30DAYS_RESULTS_PER_PAGE: process.env.LAST30DAYS_RESULTS_PER_PAGE || '100' },
});

const receipt = buildReceipt(opts, []);
log(renderReceipt(receipt));
try {
  const { writeFileSync, mkdirSync } = await import('node:fs');
  mkdirSync(join(HOME, '.pmm-os'), { recursive: true });
  writeFileSync(join(HOME, '.pmm-os', 'last-receipt.json'),
    JSON.stringify({ ...receipt, at: new Date().toISOString() }, null, 1));
} catch { /* the receipt on stdout is the primary signal */ }

if (run.status !== 0) process.exit(run.status ?? 1);
process.exit(receipt.verdict === 'CLEAN' ? 0 : 20);
